  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Web action with a filled forest surface and trailing SVG.",
      "html": "<button class=\"ds-primary\">Connect to Infinite<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;border:0;border-radius:8px;padding:13px 18px;min-height:46px;background:var(--green,#23654e);color:#fff;font:500 15px \"Instrument Sans\",sans-serif;cursor:pointer;transition:background-color 140ms ease-out}.ds-primary:hover:not(:disabled){filter:brightness(.96)}.ds-primary:focus-visible{outline:3px solid #518d75;outline-offset:3px}.ds-primary:disabled{cursor:not-allowed;opacity:.5}"
    },
    {
      "name": "Icon button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Transparent 44px web control with an accessible label.",
      "html": "<button class=\"ds-icon\" aria-label=\"New session\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:0;background:transparent;color:var(--ink,#222a27);border-radius:8px;cursor:pointer;transition:background-color 140ms ease-out}.ds-icon:hover:not(:disabled){filter:brightness(.96)}.ds-icon:focus-visible{outline:3px solid #518d75;outline-offset:3px}.ds-icon:disabled{cursor:not-allowed;opacity:.5}"
    },
    {
      "name": "Native secondary button",
      "kind": "button",
      "refersTo": "button-secondary-native",
      "description": "HTML translation of the native secondary control; native pressed feedback maps to :active in this preview.",
      "html": "<button class=\"ds-native-secondary\">Sessions</button>",
      "css": ".ds-native-secondary{min-height:48px;min-width:48px;border:0;border-radius:8px;padding:13px 18px;background:#edf0e7;color:#35533c;font:600 14px system-ui,sans-serif;cursor:pointer}.ds-native-secondary:active,.ds-native-secondary:disabled{opacity:.45}.ds-native-secondary:focus-visible{outline:3px solid #518d75;outline-offset:3px}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "field",
      "description": "Paper field with a persistent label, green caret, and visible keyboard focus.",
      "html": "<label class=\"ds-field-label\" for=\"ds-device-key\">Device key</label><input class=\"ds-field\" id=\"ds-device-key\" type=\"password\" placeholder=\"Paste your private device key\" autocomplete=\"off\">",
      "css": ".ds-field-label{display:block;font:500 15px \"Instrument Sans\",sans-serif;color:var(--ink,#222a27);margin-bottom:9px}.ds-field{width:100%;border:1px solid #bcc6b9;background:var(--paper,#fafaf6);border-radius:8px;padding:13px 14px;min-height:46px;font:400 15px \"Instrument Sans\",sans-serif;color:var(--ink,#222a27);caret-color:var(--green,#23654e)}.ds-field::placeholder{color:#687469}.ds-field:focus-visible{outline:3px solid #518d75;outline-offset:3px}"
    },
    {
      "name": "Selected session row",
      "kind": "nav",
      "refersTo": "session-row-selected",
      "description": "The rail record keeps title, provider, state, and a short stable ID together. Preview values are illustrative.",
      "html": "<button class=\"ds-session\"><span class=\"ds-session-top\"><span class=\"ds-dot\"></span><strong>Review the workspace</strong></span><span class=\"ds-session-meta\"><span>Rehearsal</span><span>running</span></span><span class=\"ds-session-meta ds-session-id\">a12b34c5</span></button>",
      "css": ".ds-session{width:100%;border:0;background:#dce3d5;padding:16px 14px;text-align:left;border-radius:8px;margin-bottom:5px;font-family:\"Instrument Sans\",sans-serif;color:var(--ink,#222a27);cursor:pointer;transition:background-color 140ms ease-out}.ds-session-top{display:flex;align-items:center;gap:9px}.ds-session-top strong{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px;font-weight:500}.ds-dot{width:7px;height:7px;flex-shrink:0;background:#307d54;border-radius:50%}.ds-session-meta{display:flex;justify-content:space-between;gap:6px;padding-left:16px;margin-top:9px;font-size:11px;color:var(--muted,#59645e)}.ds-session-id{font-family:ui-monospace,monospace;margin-top:5px}.ds-session:hover{filter:brightness(.96)}.ds-session:focus-visible{outline:3px solid #518d75;outline-offset:3px}"
    },
    {
      "name": "Session views",
      "kind": "nav",
      "refersTo": "tab-selected",
      "description": "Web view tabs use a green underline within the same session frame.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Session views\"><button role=\"tab\" aria-selected=\"true\">Catch up</button><button role=\"tab\" aria-selected=\"false\">Full terminal</button><button role=\"tab\" aria-selected=\"false\">Context</button></div>",
      "css": ".ds-tabs{display:flex;gap:28px;border-bottom:1px solid var(--rule,#d5d9d1);align-items:center}.ds-tabs button{border:0;border-bottom:2px solid transparent;padding:15px 0 16px;background:transparent;font:400 13px \"Instrument Sans\",sans-serif;color:var(--muted,#59645e);min-height:44px;min-width:44px;cursor:pointer;transition:background-color 140ms ease-out}.ds-tabs button[aria-selected=\"true\"]{border-bottom-color:var(--green,#23654e);color:var(--green,#23654e);font-weight:600}.ds-tabs button:hover{filter:brightness(.96)}.ds-tabs button:focus-visible{outline:3px solid #518d75;outline-offset:3px}"
    },
    {
      "name": "Screen snapshot",
      "kind": "card",
      "refersTo": "screen-snapshot",
      "description": "Pale inset for preserved terminal text; the specimen uses the actual empty-state wording.",
      "html": "<pre class=\"ds-screen\">Waiting for output…</pre>",
      "css": ".ds-screen{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;margin:0;background:#eef1e9;padding:22px;border-radius:12px;max-height:360px;overflow:auto;color:#334431}"
    },
    {
      "name": "Pairing sheet",
      "kind": "card",
      "refersTo": "pairing-sheet",
      "description": "The standalone web sheet is flat, bounded, and more rounded than controls.",
      "html": "<div class=\"ds-pair-sheet\"><h1>Pick up where<br>you left off.</h1><p>Your agents stay with the host.<br>Connect this device to see their progress.</p></div>",
      "css": ".ds-pair-sheet{width:min(100%,470px);padding:48px;background:var(--paper,#fafaf6);border-radius:16px;color:var(--ink,#222a27);font:400 15px \"Instrument Sans\",sans-serif}.ds-pair-sheet h1{font-size:42px;line-height:1.1;letter-spacing:-.035em;font-weight:500;margin-top:0;text-wrap:balance}.ds-pair-sheet p{color:var(--muted,#59645e);margin-top:22px;line-height:1.6}"
    },
    {
      "name": "Session composer",
      "kind": "custom",
      "refersTo": "composer",
      "description": "One focus boundary combines the editable message with a 44px send control.",
      "html": "<form class=\"ds-composer\"><textarea class=\"ds-message\" aria-label=\"Message to agent\" rows=\"2\" placeholder=\"Give this session a direction…\"></textarea><button class=\"ds-send\" aria-label=\"Send message\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg></button></form>",
      "css": ".ds-composer{border:1px solid #bac6b4;border-radius:12px;display:flex;align-items:flex-end;padding:8px;background:#fff}.ds-message{flex:1;min-width:0;border:0;min-height:52px;max-height:170px;background:transparent;font:400 13px/1.55 \"Instrument Sans\",sans-serif;color:var(--ink,#222a27);padding:7px;resize:vertical;caret-color:var(--green,#23654e)}.ds-message::placeholder{color:#687469}.ds-message:focus-visible{outline:0}.ds-composer:focus-within{outline:2px solid #518d75;outline-offset:2px}.ds-send{border:0;border-radius:8px;min-width:44px;height:44px;background:var(--green,#23654e);color:#fff;display:grid;place-items:center;cursor:pointer;transition:background-color 140ms ease-out}.ds-send:hover:not(:disabled){filter:brightness(.96)}.ds-send:focus-visible{outline:3px solid #518d75;outline-offset:3px}.ds-send:disabled{cursor:not-allowed;opacity:.5}"
    },
    {
      "name": "Terminal replay surface",
      "kind": "custom",
