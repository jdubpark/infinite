{
  "expo": {
    "name": "Infinite",
    "slug": "infinite-private",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.infinite.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "dev.infinite.app",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Infinite uses the microphone so you can dictate text into a field.",
          "speechRecognitionPermission": "Infinite uses speech recognition to turn your dictation into text."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#23654e",
          "defaultChannel": "attention"
        }
      ]
    ],
    "scheme": "infinite",
    "extra": {
      "router": {}
    }
  }
}
