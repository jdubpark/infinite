# /etc/sudoers.d/infinite-eval. Install only after the infinite-eval account exists, and check with visudo -cf first.
# The host may run the launcher as the eval account, and the four provider wrappers and the transcript drain.
# infinite.sudoers does not change. The launcher receives none of the host's variables (!env_keep).
Defaults!/usr/local/libexec/infinite/eval-command !env_keep
infinite-host ALL=(infinite-eval) NOPASSWD: /usr/local/libexec/infinite/eval-command
infinite-host ALL=(infinite-eval) NOPASSWD: /usr/local/libexec/infinite/eval/claude *, /usr/local/libexec/infinite/eval/codex *, /usr/local/libexec/infinite/eval/codex-app-server *, /usr/local/libexec/infinite/eval/opencode *
infinite-host ALL=(infinite-eval) NOPASSWD: /usr/local/libexec/infinite/eval/transcript-drain ""
