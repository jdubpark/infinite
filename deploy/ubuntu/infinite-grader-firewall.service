[Unit]
Description=Infinite grader account output rule (see deploy/ubuntu/grader.md)
After=nftables.service
Before=infinite.service
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/infinite/grader.nft
ExecReload=/usr/sbin/nft -f /etc/infinite/grader.nft
ExecStop=-/usr/sbin/nft delete table inet infinite_grader

[Install]
WantedBy=multi-user.target
