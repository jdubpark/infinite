[Unit]
Description=Infinite grader account output rule (see deploy/ubuntu/grader.md)
# Loads after the system ruleset, which may flush everything, and before the host can start a grading command.
After=nftables.service
Before=infinite.service
# Restarting or reloading nftables.service flushes every table, this one included, so this unit follows it.
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The file deletes and recreates only the inet infinite_grader table, in one transaction. A file that fails to load
# leaves the previous table in force.
ExecStart=/usr/sbin/nft -f /etc/infinite/grader.nft
ExecReload=/usr/sbin/nft -f /etc/infinite/grader.nft
# Stopping the unit removes the rule, so grading commands reach private ranges. Stop validation and trials first.
ExecStop=-/usr/sbin/nft delete table inet infinite_grader

[Install]
WantedBy=multi-user.target
