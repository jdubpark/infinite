[Unit]
Description=Infinite encrypted relay (loopback and a private socket; published through Cloudflare Tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=infinite-relay
Group=infinite-relay
WorkingDirectory=/opt/infinite
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/node /opt/infinite/packages/host/dist/cli.js relay-serve --config /etc/infinite-relay/relay.json
Restart=on-failure
RestartSec=3
# Holds proxy.sock (mode 0600). Only root's cloudflared can connect; agent accounts cannot.
RuntimeDirectory=infinite-relay
RuntimeDirectoryMode=0700
UMask=0077
LimitCORE=0
LimitNOFILE=4096
MemoryMax=512M
TasksMax=64
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# The relay only reads its config, listens on loopback for the runner, and on its socket for
# cloudflared. It holds no device keys.

[Install]
WantedBy=multi-user.target
