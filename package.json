{
  "name": "infinite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare:codex": "node scripts/build-codex-handoff.mjs",
    "postinstall": "node scripts/prepare-pty.mjs && npm run build -w @infinite/attention",
    "build": "npm run build -w @infinite/attention && npm run build -w @infinite/host && npm run build -w @infinite/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @infinite/attention && tsx --test --test-concurrency=1 tests/*.test.ts",
    "dev": "tsx packages/host/src/cli.ts dev",
    "host": "node packages/host/dist/cli.js",
    "web": "npm run dev -w @infinite/web",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
